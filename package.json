{
  "name": "critique-markup-vscode-ext",
  "displayName": "Critque Markup for Markdown Comments",
  "description": "Provides a comment layer for Markdown with UX inspired by Google Docs comments, suggested edits, Microsoft Word revisions and redlining, GitHub inline comments, and suggested code changes.",
  "version": "2.0.3",
  "publisher": "xinbenlv",
  "license": "MIT",
  "icon": "assets/icon.png",
  "homepage": "https://github.com/xinbenlv/critique-markup-vscode-ext#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/xinbenlv/critique-markup-vscode-ext.git"
  },
  "bugs": {
    "url": "https://github.com/xinbenlv/critique-markup-vscode-ext/issues"
  },
  "galleryBanner": {
    "color": "#202430",
    "theme": "dark"
  },
  "markdown": "github",
  "pricing": "Free",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "critic markup",
    "markdown review",
    "ai coding plan",
    "editor review"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onCommand:critiqueMarkup.add",
    "onCommand:critiqueMarkup.delete",
    "onCommand:critiqueMarkup.substitute",
    "onCommand:critiqueMarkup.commentOver",
    "onCommand:critiqueMarkup.acceptReview",
    "onCommand:critiqueMarkup.rejectReview"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "critiqueMarkup.add",
        "title": "Critque Markup: Add"
      },
      {
        "command": "critiqueMarkup.delete",
        "title": "Critque Markup: Delete"
      },
      {
        "command": "critiqueMarkup.substitute",
        "title": "Critque Markup: Substitute"
      },
      {
        "command": "critiqueMarkup.commentOver",
        "title": "Critque Markup: Comment Over"
      },
      {
        "command": "critiqueMarkup.acceptReview",
        "title": "Critque Markup: Accept Review"
      },
      {
        "command": "critiqueMarkup.rejectReview",
        "title": "Critque Markup: Reject Review"
      }
    ],
    "keybindings": [
      {
        "command": "critiqueMarkup.add",
        "key": "cmd+alt+=",
        "mac": "cmd+alt+=",
        "when": "editorTextFocus"
      },
      {
        "command": "critiqueMarkup.delete",
        "key": "cmd+alt+-",
        "mac": "cmd+alt+-",
        "when": "editorTextFocus"
      },
      {
        "command": "critiqueMarkup.substitute",
        "key": "cmd+alt+\\",
        "mac": "cmd+alt+\\",
        "when": "editorTextFocus"
      },
      {
        "command": "critiqueMarkup.commentOver",
        "key": "cmd+alt+/",
        "mac": "cmd+alt+/",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "critiqueMarkup.commentOver",
          "when": "resourceLangId == markdown && editorHasSelection"
        },
        {
          "command": "critiqueMarkup.delete",
          "when": "resourceLangId == markdown && editorHasSelection"
        },
        {
          "command": "critiqueMarkup.substitute",
          "when": "resourceLangId == markdown && editorHasSelection"
        },
        {
          "command": "critiqueMarkup.add",
          "when": "resourceLangId == markdown && !editorHasSelection"
        }
      ]
    }
  },
  "scripts": {
    "compile": "rm -rf out && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "visual-regression": "node ./scripts/generate-visual-assets.js",
    "publish:extension": "node ./scripts/publish.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.100.0",
    "@vscode/test-electron": "^2.5.2",
    "glob": "^11.0.3",
    "mocha": "^11.7.1",
    "playwright": "^1.59.1",
    "typescript": "^5.8.3"
  }
}
